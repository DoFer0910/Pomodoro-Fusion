{
    "manifest_version": 3,
    "name": "Pomodoro Fusion Auto-Launch",
    "version": "1.0",
    "description": "Automatically launches Pomodoro Fusion when you visit specific sites.",
    "permissions": [
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Pomodoro Launcher Settings"
    }
}